<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\AutoHub.SharedKernel\AutoHub.SharedKernel.csproj" />
    <ProjectReference Include="..\..\AutoHub.Platform\AutoHub.Platform.csproj" />
    <!--
      Referenced for its Contracts folder only — IVehicleDirectory and IVehicleTaxonomy. A listing is
      an intent to transact a canonical vehicle, so it cannot exist without resolving one, and
      resolution must go through the catalog's deduplication rather than around it.

      The module isolation rule is a review rule, not a compiler one: MSBuild brings the whole
      assembly across and nothing stops a handler here reaching into Catalog.Domain. What stops it is
      that doing so makes the extraction promise false, and this comment is where a reviewer objects.
    -->
    <ProjectReference Include="..\AutoHub.Modules.Catalog\AutoHub.Modules.Catalog.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
