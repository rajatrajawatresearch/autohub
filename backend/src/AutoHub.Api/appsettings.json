{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Urls": "http://localhost:5180",

  "Jwt": {
    "Issuer": "https://autohub.in",
    "Audience": "autohub-api",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "30.00:00:00"
  },

  "Otp": {
    "CodeLength": 6,
    "Lifetime": "00:05:00",
    "ResendCooldown": "00:00:30",
    "MaxAttempts": 5,
    "MaxChallengesPerWindow": 5,
    "ThrottleWindow": "01:00:00",
    "ReturnCodeInResponse": false
  },

  "Cors": {
    "Origins": [
      "http://localhost:3100",
      "http://localhost:3101",
      "http://localhost:3102"
    ]
  },

  "RateLimiting": {
    "Window": "00:01:00",
    "DefaultPermits": 120,
    "Tiers": {
      "anonymous": 60,
      "authenticated": 300
    }
  },

  "Outbox": {
    "PollInterval": "00:00:05",
    "BatchSize": 100,
    "MaxAttempts": 10
  },

  "Idempotency": {
    "Retention": "1.00:00:00"
  }
}
