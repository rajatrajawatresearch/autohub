# Real secrets live in the secret store; the integration registry holds only a credentialRef.
# This file exists so a new developer knows which keys are expected, never their values.

ConnectionStrings__Postgres=Host=localhost;Port=5433;Database=autohub;Username=autohub;Password=autohub_dev
ConnectionStrings__Redis=localhost:6380

Jwt__Issuer=https://api.autohub.local
Jwt__Audience=autohub
Jwt__SigningKey=dev-only-signing-key-replace-in-every-other-environment

# Development only: return the OTP in the response instead of sending an SMS.
# Guarded by the environment check in AuthEndpoints — never true outside Development.
Auth__ReturnOtpInResponse=true

Search__OpenSearchUrl=http://localhost:9201
Storage__Endpoint=http://localhost:9010
Otel__Endpoint=http://localhost:4328
