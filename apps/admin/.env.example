# Copy to .env.local. Nothing here is a secret — NEXT_PUBLIC_* is compiled into the browser bundle,
# so anything that must stay private belongs on the API, not in this file.

NEXT_PUBLIC_API_URL=http://localhost:5180/api/v1

# 1 = serve fixture data from @autohub/api instead of calling the API.
# Lets the portals run and demo with the backend stopped.
NEXT_PUBLIC_API_MOCK=1

NEXT_PUBLIC_DEFAULT_LOCALE=en-IN
NEXT_PUBLIC_DEFAULT_CITY=pune
